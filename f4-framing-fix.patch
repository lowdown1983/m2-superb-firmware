 //   len + (bus<<4), data bytes, trailing 0x00.
 // M2RET buffers and flushes every ~2ms; Phase 1 writes directly (simpler;
 // the Bee UART at 115200 is the bottleneck either way).
+//
+// F4 (audit fix): escape 0xF1 as F1 00 on the data plane. The SuperB's RX
+// diverter treats any F1 7E pair on the Bee link as a control frame, and
+// raw binary GVRET bytes (timestamps, IDs, CAN payload) can contain that
+// pair — the diverter would silently swallow bytes from the app stream.
+// Escaping every data-plane 0xF1 makes the wire unambiguous; the SuperB
+// unescapes before broadcast, so apps see the pristine GVRET stream.
+// Control frames (mm::sendReply) bypass this helper and stay unescaped.
+void dataWrite(const uint8_t* data, size_t len)
+{
+    for (size_t i = 0; i < len; i++) {
+        if (data[i] == 0xF1) {
+            Serial.write((uint8_t)0xF1);
+            Serial.write((uint8_t)0x00);
+        } else {
+            Serial.write(data[i]);
+        }
+    }
+}
+void dataWriteByte(uint8_t b) { dataWrite(&b, 1); }
